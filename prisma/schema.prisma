generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model admin_users {
  id        String   @id
  email     String   @unique
  password  String
  name      String
  role      String   @default("admin")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model application_categories {
  id                String              @id
  title             String
  sortOrder         Int                 @default(0)
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  application_items application_items[]
}

model application_items {
  id                     String                 @id
  name                   String
  categoryId             String
  sortOrder              Int                    @default(0)
  isActive               Boolean                @default(true)
  application_categories application_categories @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model catalogues {
  id           String         @id
  title        String
  description  String?
  coverImage   String?
  pdfUrl       String?
  sortOrder    Int            @default(0)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
  kit_products kit_products[]
}

model categories {
  id                      String                    @id
  name                    String
  slug                    String                    @unique
  description             String?
  image                   String?
  sortOrder               Int                       @default(0)
  isActive                Boolean                   @default(true)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  icon                    String?
  color                   String?                   @default("#2D2B7F")
  parentId                String?
  isKitCategory           Boolean                   @default(false)
  categories              categories?               @relation("categoriesTocategories", fields: [parentId], references: [id])
  other_categories        categories[]              @relation("categoriesTocategories")
  lab_consumable_products lab_consumable_products[]
  products                products[]
}

model certificates {
  id        String   @id
  title     String
  image     String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model contact_messages {
  id        String   @id
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model contact_pages {
  id            String   @id
  title         String   @default("Contact Us")
  subtitle      String?
  description   String?
  email         String?
  phone         String?
  address       String?
  businessHours String?
  mapEmbedUrl   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime
}

model cro_services {
  id         String   @id
  slug       String   @unique
  title      String
  heading    String?
  subheading String?
  banner     String?
  content    String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime
}

model disclaimers {
  id                String   @id
  title             String   @default("Data & Privacy Notice")
  content           String
  isActive          Boolean  @default(true)
  acceptButtonText  String   @default("I Accept")
  declineButtonText String   @default("Decline")
  createdAt         DateTime @default(now())
  updatedAt         DateTime
}

model faqs {
  id         String   @id
  slug       String   @unique
  title      String
  heading    String?
  subheading String?
  banner     String?
  content    String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime
}

model hero_slides {
  id            String   @id
  title         String
  subtitle      String?
  description   String?
  ctaText       String?
  ctaLink       String?
  bgGradient    String?
  accentColor   String?  @default("#6C63FF")
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  bgImage       String?
  ctaType       String?  @default("link")
  pdfLabel      String?
  pdfUrl        String?
  quoteCtaLabel String?
}

model job_openings {
  id               String   @id
  title            String
  department       String?
  location         String?
  type             String?  @default("Full-Time")
  description      String?
  responsibilities String[]
  requirements     String[]
  isActive         Boolean  @default(true)
  postedAt         DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime
}

model kit_products {
  id                      String                    @id
  title                   String
  description             String?
  image                   String?
  href                    String?
  sortOrder               Int                       @default(0)
  isActive                Boolean                   @default(true)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  slug                    String?
  heroTitle               String?
  associatedProducts      String?
  content                 String?
  subtitle                String?
  catalogId               String?
  catalogues              catalogues?               @relation(fields: [catalogId], references: [id])
  lab_consumable_products lab_consumable_products[]
}

model lab_consumable_products {
  id           String        @id
  title        String
  subheading   String?
  content      String?
  image        String?
  categoryId   String?
  kitProductId String?
  sortOrder    Int           @default(0)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime
  categories   categories?   @relation(fields: [categoryId], references: [id])
  kit_products kit_products? @relation(fields: [kitProductId], references: [id])
}

model pages {
  id        String   @id
  slug      String   @unique
  title     String
  subtitle  String?
  content   Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model product_variants {
  id        String   @id
  productId String
  sku       String?
  packSize  String?
  price     Decimal? @default(0)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime
  products  products @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model products {
  id                    String             @id
  catalogNumber         String             @unique
  name                  String
  description           String?
  categoryId            String?
  manufacturer          String?
  material              String?
  volume                String?
  needleShape           String?
  size                  String?
  image                 String?
  isFeatured            Boolean            @default(false)
  isActive              Boolean            @default(true)
  sortOrder             Int                @default(0)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime
  abApplicationType     String?
  abCalculatedMw        String?
  abCloneType           String?
  abDilutionRatio       String?
  abGeneId              String?
  abHost                String?
  abImmunogen           String?
  abIsotype             String?
  abPurification        String?
  abReactivity          String?
  abStorageBuffer       String?
  abSubcellularLocation String?
  abSwissProt           String?
  abTarget              String?
  abType                String?
  applications          String?
  brand                 String?
  casNumber             String?
  elisaChineseName      String?
  elisaDetectionRange   String?
  elisaReactivity       String?
  elisaSampleType       String?
  elisaSensitivity      String?
  histoPrimaryCategory  String?
  mediaExpiry           String?
  primaryCategory       String?
  productLine           String?
  purity                String?
  section               String?
  storage               String?
  subCategory           String?
  product_variants      product_variants[]
  categories            categories?        @relation(fields: [categoryId], references: [id])
}

model quote_items {
  id             String         @id
  quoteId        String
  productId      String?
  sku            String?
  name           String
  quantity       Int            @default(1)
  quote_requests quote_requests @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model quote_requests {
  id          String        @id
  orderId     String        @unique
  name        String
  email       String
  phone       String?
  company     String?
  status      String        @default("pending")
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime
  userId      String?
  quote_items quote_items[]
  users       users?        @relation(fields: [userId], references: [id])
}

model signaling_pathways {
  id         String   @id
  slug       String   @unique
  title      String
  heading    String?
  subheading String?
  banner     String?
  content    String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime
}

model site_settings {
  id    String @id
  key   String @unique
  value String
  type  String @default("text")
}

model users {
  id             String           @id
  email          String           @unique
  password       String
  name           String
  company        String?
  phone          String?
  country        String?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  quote_requests quote_requests[]
}

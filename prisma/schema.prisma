generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("admin")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_users")
}

model ApplicationCategory {
  id        String            @id @default(cuid())
  title     String
  sortOrder Int               @default(0)
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  items     ApplicationItem[]

  @@map("application_categories")
}

model ApplicationItem {
  id         String              @id @default(cuid())
  name       String
  categoryId String
  sortOrder  Int                 @default(0)
  isActive   Boolean             @default(true)
  category   ApplicationCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("application_items")
}

model Category {
  id        String      @id @default(cuid())
  name      String
  slug      String      @unique
  description String?
  image     String?
  sortOrder Int         @default(0)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  icon      String?
  color     String?     @default("#2D2B7F")
  parentId  String?
  parent    Category?   @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[]  @relation("CategoryTree")
  products  Product[]

  @@map("categories")
}

model HeroSlide {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  description String?
  ctaText     String?
  ctaLink     String?
  bgImage     String?
  bgGradient  String?
  accentColor String?  @default("#6C63FF")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("hero_slides")
}

model JobOpening {
  id               String   @id @default(cuid())
  title            String
  department       String?
  location         String?
  type             String?  @default("Full-Time")
  description      String?
  responsibilities String[]
  requirements     String[]
  isActive         Boolean  @default(true)
  postedAt         DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("job_openings")
}

model KitProduct {
  id                 String   @id @default(cuid())
  title              String
  slug               String?
  description        String?
  image              String?
  href               String?
  heroTitle          String?
  associatedProducts String?
  sortOrder          Int      @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("kit_products")
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  subtitle  String?
  content   Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pages")
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  sku       String?
  packSize  String?
  price     Decimal? @default(0)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}

model Product {
  id                    String           @id @default(cuid())
  catalogNumber         String           @unique
  name                  String
  description           String?
  categoryId            String?
  manufacturer          String?
  material              String?
  volume                String?
  needleShape           String?
  size                  String?
  image                 String?
  isFeatured            Boolean          @default(false)
  isActive              Boolean          @default(true)
  sortOrder             Int              @default(0)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  abApplicationType     String?
  abCalculatedMw        String?
  abCloneType           String?
  abDilutionRatio       String?
  abGeneId              String?
  abHost                String?
  abImmunogen           String?
  abIsotype             String?
  abPurification        String?
  abReactivity          String?
  abStorageBuffer       String?
  abSubcellularLocation String?
  abSwissProt           String?
  abTarget              String?
  abType                String?
  applications          String?
  brand                 String?
  casNumber             String?
  elisaChineseName      String?
  elisaDetectionRange   String?
  elisaReactivity       String?
  elisaSampleType       String?
  elisaSensitivity      String?
  histoPrimaryCategory  String?
  mediaExpiry           String?
  primaryCategory       String?
  productLine           String?
  purity                String?
  section               String?
  storage               String?
  subCategory           String?
  variants              ProductVariant[]
  category              Category?        @relation(fields: [categoryId], references: [id])

  @@map("products")
}

model QuoteItem {
  id        String       @id @default(cuid())
  quoteId   String
  productId String?
  sku       String?
  name      String
  quantity  Int          @default(1)
  quote     QuoteRequest @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@map("quote_items")
}

model QuoteRequest {
  id        String      @id @default(cuid())
  orderId   String      @unique @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  status    String      @default("pending")
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  userId    String?
  items     QuoteItem[]
  user      User?       @relation(fields: [userId], references: [id])

  @@map("quote_requests")
}

model Disclaimer {
  id                String   @id @default(cuid())
  title             String   @default("Data & Privacy Notice")
  content           String
  isActive          Boolean  @default(true)
  acceptButtonText  String   @default("I Accept")
  declineButtonText String   @default("Decline")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("disclaimers")
}

model ContactPage {
  id            String   @id @default(cuid())
  title         String   @default("Contact Us")
  subtitle      String?
  description   String?
  email         String?
  phone         String?
  address       String?
  businessHours String?
  mapEmbedUrl   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("contact_pages")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_messages")
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  type  String @default("text")

  @@map("site_settings")
}

model User {
  id        String         @id @default(cuid())
  email     String         @unique
  password  String
  name      String
  company   String?
  phone     String?
  country   String?
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  quotes    QuoteRequest[]

  @@map("users")
}

// Sri Saradi Scientific - Database Schema
// PostgreSQL via Prisma ORM

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =====================
// ADMIN USERS
// =====================
model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("admin") // admin | superadmin
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_users")
}

// =====================
// CUSTOMER USERS
// =====================
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  company   String?
  phone     String?
  country   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotes QuoteRequest[]

  @@map("users")
}

// =====================
// CATEGORIES (supports hierarchy via parentId)
// =====================
model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  icon        String?
  color       String?  @default("#2D2B7F")
  parentId    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  products Product[]

  @@map("categories")
}

// =====================
// PRODUCTS (Unified — supports multiple brands)
// =====================
model Product {
  id               String   @id @default(cuid())
  catalogNumber    String   @unique                 // e.g. "SE131", "HAM-001"
  name             String
  description      String?
  productLine      String?                          // e.g. "Solarbio Life Sciences"
  brand            String?                          // e.g. "Solarbio", "Hamilton"
  manufacturer     String?

  // ── Category links ──
  categoryId       String?                          // FK → Category (general)
  primaryCategory  String?                          // free-text primary category
  subCategory      String?                          // free-text sub category

  // ── Core product-level fields ──
  applications     String?
  casNumber        String?
  purity           String?
  storage          String?                          // e.g. "-20°C", "RT"
  image            String?

  // ── Legacy / general fields ──
  material         String?
  volume           String?
  needleShape      String?
  size             String?
  section          String?                          // display section label (e.g. "Explore Antibodies")

  // ── Antibody-specific fields ──
  abType               String?
  abHost               String?
  abReactivity         String?
  abTarget             String?
  abCloneType          String?
  abIsotype            String?
  abImmunogen          String?
  abCalculatedMw       String?
  abPurification       String?
  abStorageBuffer      String?
  abGeneId             String?
  abSubcellularLocation String?
  abSwissProt          String?
  abDilutionRatio      String?
  abApplicationType    String?

  // ── ELISA-specific fields ──
  elisaDetectionRange  String?
  elisaSensitivity     String?
  elisaReactivity      String?
  elisaSampleType      String?
  elisaChineseName     String?

  // ── Other specialised fields ──
  mediaExpiry          String?
  histoPrimaryCategory String?

  // ── Flags & meta ──
  isFeatured    Boolean  @default(false)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category         Category?         @relation(fields: [categoryId], references: [id])
  variants         ProductVariant[]

  @@map("products")
}

// =====================
// PRODUCT VARIANTS (Pack Size = Variation)
// Each variant represents one pack-size / SKU with its own pricing & scientific details
// =====================
model ProductVariant {
  id          String   @id @default(cuid())
  productId   String

  // ── Pricing & Packaging ──
  sku         String?
  packSize    String?                               // e.g. "100ml", "500g", "2 ea"
  price       Decimal? @default(0)

  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_variants")
}

// =====================
// HERO SLIDES
// =====================
model HeroSlide {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  description String?
  ctaText     String?
  ctaLink     String?
  
  bgGradient  String?
  accentColor String?  @default("#6C63FF")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("hero_slides")
}

// =====================
// KIT PRODUCTS (Homepage section)
// =====================
model KitProduct {
  id          String   @id @default(cuid())
  title       String
  description String?
  image       String?
  href        String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("kit_products")
}

// =====================
// APPLICATION CATEGORIES
// =====================
model ApplicationCategory {
  id        String   @id @default(cuid())
  title     String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ApplicationItem[]

  @@map("application_categories")
}

model ApplicationItem {
  id         String  @id @default(cuid())
  name       String
  categoryId String
  sortOrder  Int     @default(0)
  isActive   Boolean @default(true)

  category ApplicationCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("application_items")
}

// =====================
// CAREERS / JOB OPENINGS
// =====================
model JobOpening {
  id               String   @id @default(cuid())
  title            String
  department       String?
  location         String?
  type             String?  @default("Full-Time")
  description      String?
  responsibilities String[]
  requirements     String[]
  isActive         Boolean  @default(true)
  postedAt         DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("job_openings")
}

// =====================
// PAGES (CMS - About, Terms, Privacy)
// =====================
model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  subtitle  String?
  content   Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pages")
}

// =====================
// QUOTE REQUESTS
// =====================
model QuoteRequest {
  id        String   @id @default(cuid())
  orderId   String   @unique @default(cuid())
  userId    String?                                     // FK → User (optional if guest quote)
  name      String
  email     String
  phone     String?
  company   String?
  status    String   @default("pending")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  items QuoteItem[]

  @@map("quote_requests")
}

model QuoteItem {
  id        String  @id @default(cuid())
  quoteId   String
  productId String?
  sku       String?
  name      String
  quantity  Int     @default(1)

  quote QuoteRequest @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@map("quote_items")
}

// =====================
// SITE SETTINGS
// =====================
model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  type  String @default("text")

  @@map("site_settings")
}
